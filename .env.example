# Copy to .env (git-ignored) or export in your shell. Names only, no secrets.
PIPELINE_ENV=local
# Directory containing tech_news.csv and company_metadata.json
DATA_DIR=data/raw
# Directory where the CSV exports are written
OUTPUTS_DIR=outputs
# DuckDB warehouse file
WAREHOUSE_PATH=data/warehouse/pipeline.duckdb
# Sentence-transformers model used for embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO
